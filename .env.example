# Agent Memory Layer (memlayer) Environment Configuration Template
# Copy this file to .env and fill in the values. NEVER commit .env to git.

# -----------------------------------------------------------------------------
# LLM Providers (LiteLLM)
# -----------------------------------------------------------------------------
# Provide keys for the models you plan to use (e.g. Gemini, Groq, OpenAI, Ollama)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default models
EXTRACTION_MODEL=gemini/gemini-2.0-flash
ANSWER_MODEL=gemini/gemini-2.0-flash
JUDGE_MODEL=gemini/gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# Storage Backends
# -----------------------------------------------------------------------------
# Relational store (SQLite for local, PostgreSQL for server)
# SQLite: sqlite+aiosqlite:///./memlayer.db
# Postgres: postgresql+asyncpg://postgres:postgres@localhost:5432/memlayer
DATABASE_URL=sqlite+aiosqlite:///./memlayer.db

# Vector store: "qdrant" or "pgvector"
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Observability & Tracing (Langfuse)
# -----------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
